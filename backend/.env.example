# ======================================
# Crypto Sim — Backend Environment Config
# ======================================
# Exchange: okx (默认) | binance
EXCHANGE=okx

# OKX 公共行情无需 API Key。如需后续扩展私有接口，在此填写。
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Binance（备用）
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# 模拟账户初始资金（USDT）
INITIAL_CAPITAL=10000

# 模拟交易成本 —— 让模拟结果更接近真实盘
# 手续费率（0.001 = 0.1%，币安/OKX 现货的典型值）
FEE_RATE=0.001
# 市价单滑点（0.0005 = 0.05%，买入成交价高一点、卖出成交价低一点）
SLIPPAGE_PCT=0.0005

# SQLite 数据文件路径
DB_PATH=./data.db

# 允许的前端跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 后端监听端口
BACKEND_PORT=8000
